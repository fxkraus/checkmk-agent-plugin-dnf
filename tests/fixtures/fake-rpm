#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Stand-in for rpm in the BATS reboot tests; ignores --qf.
#
#   rpm -qf <file>  prints $FAKE_PM_DIR/config-owners ("NAME VERSION-RELEASE"
#                   lines), or exits 1 like rpm does for a file no package owns.
#                   If $FAKE_PM_DIR/owned-paths exists, only the files listed
#                   there are owned. Each queried file is appended to
#                   $FAKE_PM_DIR/rpm-qf.args.
#   rpm -q <name>   prints $FAKE_PM_DIR/kernels (installed VERSION-RELEASE
#                   lines, in install order)

: "${FAKE_PM_DIR:?FAKE_PM_DIR must point at the fake responses}"

case "$1" in
    -qf)
        file="${*: -1}"
        echo "${file}" >> "${FAKE_PM_DIR}/rpm-qf.args"
        if [[ ! -f "${FAKE_PM_DIR}/config-owners" ]] \
            || { [[ -f "${FAKE_PM_DIR}/owned-paths" ]] \
                 && ! grep -qxF -- "${file}" "${FAKE_PM_DIR}/owned-paths"; }; then
            echo "file ${file} is not owned by any package"
            exit 1
        fi
        cat "${FAKE_PM_DIR}/config-owners"
        ;;
    -q)
        cat "${FAKE_PM_DIR}/kernels"
        ;;
    *)
        exit 1
        ;;
esac
