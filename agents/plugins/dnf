# Set the version to be captured in newer versions of CheckMK inventory
# shellcheck disable=SC2034
CMK_VERSION="0.0.0"

# Disable globbing to prevent accidental pathname expansion
set -o noglob

# The parsers match English package-manager output. The refresh's transient
# systemd unit doesn't inherit the agent's environment and gets the system
# locale (LANG from /etc/locale.conf), so pin it here for every code path.
export LC_ALL=C

# --- Constants ---
# Overall limit for one background refresh, in seconds
readonly REFRESH_TIMEOUT=300
# Limit when setsid/flock are missing and the refresh has to run inline;
# stays below Checkmk's 60 s agent timeout
readonly INLINE_REFRESH_TIMEOUT=45
# Minimum time between refresh attempts while the last one failed or did not
# finish, so a persistent dnf failure doesn't run dnf on every agent call
readonly RETRY_INTERVAL=900
# dnf5 transactions searched for the last upgrade, newest first: in total and
# per "history info" call
readonly HISTORY_DEPTH=500
readonly HISTORY_BATCH=50
# dnf 4/yum plugins stay enabled so versionlock (a plugin there) is honoured,
# like dnf5 does natively. The RHEL subscription plugins may contact the
# entitlement server even in cache-only mode, so they are disabled.
readonly DNF4_PLUGIN_ARGS=(--disableplugin=subscription-manager --disableplugin=product-id)

# --- Output error and exit gracefully ---
# Exit 0 so the Checkmk agent continues processing other plugins.
# The server-side check plugin handles the ERROR: prefix.
die() {
    echo "<<<dnf>>>"
    echo "ERROR: $1"
    exit 0
}

# --- Validate environment ---
if [[ -z "${MK_VARDIR:-}" ]]; then
    die "MK_VARDIR not set - agent environment unavailable"
fi

# --- Cache directory and file paths ---
readonly CACHE_DIR="${MK_VARDIR}/cache"

# Ensure cache directory exists and is usable. umask 022 keeps any directory
# created here from failing the permission checks below.
if ! (umask 022 && mkdir -p "${CACHE_DIR}"); then
    die "Unable to create cache directory: ${CACHE_DIR}"
fi

# Whoever can write to MK_VARDIR could swap the cache directory for a symlink
# after it has been checked, so it must belong to the agent's user or root.
read -r vardir_uid vardir_mode < <(stat -L -c '%u %a' "${MK_VARDIR}" 2>/dev/null) || true
if [[ "${vardir_uid:-}" != "${EUID}" && "${vardir_uid:-}" != 0 ]] \
    || (( 8#${vardir_mode:-777} & 8#022 )); then
    die "MK_VARDIR must be owned by UID ${EUID} or root and not group- or world-writable: ${MK_VARDIR}"
fi

# Only the agent's own user may write to the cache directory; otherwise
# someone else could plant symlinks that the agent (usually root) follows.
read -r cache_dir_uid cache_dir_mode < <(stat -c '%u %a' "${CACHE_DIR}" 2>/dev/null) || true
if [[ -L "${CACHE_DIR}" || ! -d "${CACHE_DIR}" || "${cache_dir_uid:-}" != "${EUID}" ]] \
    || (( 8#${cache_dir_mode:-777} & 8#022 )); then
    die "Cache directory must be a directory owned by UID ${EUID} and not group- or world-writable: ${CACHE_DIR}"
fi

# Result lines 2-4. Named differently from the pre-async 4-line
# yum_result.cache so an upgraded plugin never serves the old format.
readonly CACHE_RESULT="${CACHE_DIR}/dnf_updates.cache"
readonly CACHE_RESULT_TMP="${CACHE_RESULT}.tmp"
readonly CACHE_PKG_STATE="${CACHE_DIR}/dnf_pkg_state.cache"
readonly CACHE_LOCK="${CACHE_DIR}/dnf_refresh.lock"
# Exists from the start of a refresh until one completes. Holds the start time
# of the first unsuccessful attempt; its mtime is the latest attempt.
readonly CACHE_PENDING="${CACHE_DIR}/dnf_refresh_pending.cache"
readonly LEGACY_CACHE_FILES=("${CACHE_DIR}/yum_result.cache" "${CACHE_DIR}/yum_uptime.cache")

# --- Cache file helpers ---

validate_cache_file() {
    local filepath="$1"
    if [[ -L "$filepath" ]]; then
        die "Cache file is a symlink: ${filepath}"
    fi
    if [[ -e "$filepath" && ! -f "$filepath" ]]; then
        die "Cache path is not a regular file: ${filepath}"
    fi
}

# Validate before creating, so a planted (dangling) symlink is never followed.
# noclobber creates the file with O_EXCL.
init_cache_file() {
    local filepath="$1"
    validate_cache_file "$filepath"
    if [[ ! -e "$filepath" ]]; then
        (set -o noclobber; : > "$filepath") 2>/dev/null || true
    fi
    validate_cache_file "$filepath"
}

# --- Detect package manager ---

detect_package_manager() {
    if command -v dnf5 >/dev/null 2>&1; then
        PKG_MGR="dnf5"
    elif command -v dnf >/dev/null 2>&1; then
        PKG_MGR="dnf"
    elif command -v yum >/dev/null 2>&1; then
        PKG_MGR="yum"
    else
        die "No supported package manager found (dnf5, dnf, or yum)"
    fi
}

# --- True if rpm orders any further version after the first one ---
# sort -V is not rpm's order: it puts the GA kernel 4.18.0-553.el8_10 after
# 4.18.0-553.5.1.el8_10. rpm's Lua gets the versions as string literals, so
# only the characters rpm allows in a version are passed on.

rpm_newer_version_exists() {
    local base="$1" version list="" newer="" valid='^[[:alnum:]._+~^-]+$'
    shift
    [[ "$base" =~ $valid ]] || return 1
    for version in "$@"; do
        [[ "$version" =~ $valid ]] && list+="'${version}',"
    done
    newer=$(rpm --eval "%{lua: local n = 0; for _, v in ipairs({${list}}) do if rpm.vercmp(v, '${base}') > 0 then n = n + 1 end end; print(n)}" 2>/dev/null) || true
    [[ "$newer" =~ ^[1-9] ]]
}

# --- Check if kernel update requires reboot ---

# The newest kernel is the highest version, not the last one installed: a
# fallback kernel installed later must not ask for a reboot.
# The running kernel's package owns its vmlinuz under /lib/modules. The
# /boot/config file is only a %ghost there and missing on some boot layouts,
# so it serves as a fallback for kernels packaged differently.
check_reboot_required() {
    local release file owners="" kernel_package running_kernel
    local -a installed

    release=$(uname -r)
    # rpm prints "not owned by any package" to stdout, so check the exit code.
    # Several packages may own the file; the first one is enough.
    for file in "/lib/modules/${release}/vmlinuz" "/boot/config-${release}"; do
        if owners=$(rpm -qf --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$file" 2>/dev/null) \
            && [[ -n "$owners" ]]; then
            break
        fi
        owners=""
    done
    if [[ -z "$owners" ]]; then
        echo "no"
        return
    fi
    read -r kernel_package running_kernel <<< "$owners"

    mapfile -t installed < <(rpm -q --qf '%{VERSION}-%{RELEASE}\n' "$kernel_package" 2>/dev/null || true)

    if rpm_newer_version_exists "$running_kernel" "${installed[@]}"; then
        echo "yes"
    else
        echo "no"
    fi
}

# --- Reboot hint from needs-restarting -r ---
# Covers core libraries and services (glibc, systemd, openssl, ...) besides
# the kernel. It reads only the rpm database, so all repositories stay
# disabled. Both the exit code and the message must match: a missing plugin
# also exits 1. Prints "yes <packages>", "no" or "unknown".

get_reboot_hint() {
    local -a cmd
    local output packages rc=0

    case "$PKG_MGR" in
        dnf5)    cmd=(dnf5 -C --quiet "--disablerepo=*" needs-restarting -r) ;;
        dnf|yum) cmd=("$PKG_MGR" -C --quiet "--disablerepo=*" "${DNF4_PLUGIN_ARGS[@]}" needs-restarting -r) ;;
    esac

    output=$("${cmd[@]}" 2>/dev/null) || rc=$?
    if [[ "$rc" == 0 && "$output" == *"Reboot should not be necessary"* ]]; then
        echo "no"
    elif [[ "$rc" == 1 && "$output" == *"Reboot is required"* ]]; then
        packages=$(awk '/^[[:space:]]+\* / {print $2}' <<< "$output" | paste -sd, -) || true
        printf 'yes %s\n' "$packages"
    else
        echo "unknown"
    fi
}

# --- List pending upgrades ---
# Prints one "name.arch" per pending upgrade. Returns 2 if the package manager
# rejected an option (e.g. --security unsupported) and 1 on any other failure
# (timeout, missing metadata cache, lock, repo error). check-update exits 100
# when upgrades exist and 0 when there are none.

list_upgrades() {
    local -a cmd
    local output rc=0

    case "$PKG_MGR" in
        dnf5)    cmd=(dnf5 -C --quiet check-upgrade) ;;
        dnf|yum) cmd=("$PKG_MGR" -C --quiet "${DNF4_PLUGIN_ARGS[@]}" check-update) ;;
    esac

    output=$("${cmd[@]}" "$@" 2>/dev/null) || rc=$?
    case "$rc" in
        0|100) ;;
        2) return 2 ;;
        *) return 1 ;;
    esac

    # Package lines start in column 1; wrapped continuation lines are indented.
    # The trailing "Obsoleting Packages" section repeats entries, so stop there.
    printf '%s\n' "$output" | awk '/^Obsoleting/ {exit} /^[^[:space:]]/ {print $1}'
}

# --- Count available package updates (-1 on error) ---

count_updates() {
    local upgrades
    if ! upgrades=$(list_upgrades); then
        echo "-1"
        return
    fi
    grep -c . <<< "$upgrades" || true
}

# --- Count security updates and list affected packages ---
# -1 on error, -2 if the package manager does not support --security.

count_security_updates() {
    local upgrades count pkg_list rc=0

    upgrades=$(list_upgrades --security) || rc=$?
    case "$rc" in
        0) ;;
        2) echo "-2"; return ;;
        *) echo "-1"; return ;;
    esac

    count=$(grep -c . <<< "$upgrades") || true
    pkg_list=$(grep . <<< "$upgrades" | sed 's/\.[^.]*$//' | paste -sd, -) || true
    printf '%s %s\n' "${count:-0}" "${pkg_list:-}"
}

# --- Timestamp of the most recent dnf5 upgrade transaction ---
# dnf5's history table leaves the Action column empty and its command-line
# column has a variable number of words, so read "history info" instead.

get_last_upgrade_dnf5() {
    local -a ids
    local history id_list begin i

    history=$(dnf5 history list 2>/dev/null) || true
    id_list=$(awk '$1 ~ /^[0-9]+$/ {print $1}' <<< "$history" | sort -rn | head -n "$HISTORY_DEPTH") || true
    read -r -d '' -a ids <<< "$id_list" || true

    # The first batch (newest first) with an upgrade contains the latest one.
    # "Begin time" is YYYY-MM-DD HH:MM:SS, so the string maximum is the latest.
    for (( i = 0; i < ${#ids[@]}; i += HISTORY_BATCH )); do
        begin=$(dnf5 history info "${ids[@]:i:HISTORY_BATCH}" 2>/dev/null \
            | awk '/^Begin time/ {sub(/^Begin time *: */, ""); begin = $0}
                   /^[[:space:]]+Upgrade[[:space:]]/ && begin > last {last = begin}
                   END {print last}')
        if [[ -n "$begin" ]]; then
            date -d "$begin" +"%s" 2>/dev/null
            return
        fi
    done
}

# --- Determine timestamp of last successful update ---

get_last_update_timestamp() {
    local timestamp=""

    case "$PKG_MGR" in
        dnf5)
            timestamp=$(get_last_upgrade_dnf5) || true
            ;;
        dnf|yum)
            # Columns: ID | Command line | Date and time | Action(s) | Altered.
            # Only the Action(s) column is matched, never the free-text command
            # line, and columns count from the right in case it contains "|".
            timestamp=$("$PKG_MGR" -C --quiet "${DNF4_PLUGIN_ARGS[@]}" history list 2>/dev/null \
                | awk -F'|' 'NR > 2 && NF >= 5 && $(NF-1) ~ /(^|[ ,])(U|Upgrade|Update)([ ,]|$)/ {print $(NF-2); exit}' \
                | date -f - +"%s" 2>/dev/null) || true
            ;;
    esac

    echo "${timestamp:--1}"
}

# --- Newest repository metadata refresh (-1 if none) ---
# Queries run cache-only, so results are only as fresh as the metadata that
# dnf-makecache.timer / dnf5-makecache.timer downloads. makecache rewrites
# repomd.xml only when a repo changed; when the metadata is still current it
# touches the primary metadata instead, so that is the last confirmed refresh.

get_metadata_timestamp() {
    local newest
    newest=$(find /var/cache/dnf /var/cache/yum /var/cache/libdnf5 \
        -name '*primary.xml*' -printf '%T@\n' 2>/dev/null | sort -n | tail -n1) || true
    newest="${newest%.*}"
    echo "${newest:--1}"
}

# --- Package state fingerprint ---
# Changes when repo metadata is refreshed (repomd.xml per repo; dnf5 keeps its
# cache in /var/cache/libdnf5), packages are installed or removed (rpmdb,
# including plain rpm -U), the versionlock list or the package manager
# configuration (excludes, repos enabled or disabled, variables) changes or
# the host reboots (boot ID, for the reboot hint). Solver caches (*.solv) are
# left out because dnf rewrites them during read-only queries.

get_pkg_state_fingerprint() {
    local repo_metadata rpmdb versionlock config boot_id
    repo_metadata=$(find /var/cache/dnf /var/cache/yum /var/cache/libdnf5 \
        -name repomd.xml -printf '%p %T@ %s\n' 2>/dev/null) || true
    rpmdb=$(find /var/lib/rpm /usr/lib/sysimage/rpm -maxdepth 1 \
        \( -name Packages -o -name rpmdb.sqlite -o -name rpmdb.sqlite-wal \) \
        -printf '%p %T@ %s\n' 2>/dev/null) || true
    versionlock=$(find /etc/dnf/plugins/versionlock.list /etc/yum/pluginconf.d/versionlock.list \
        /etc/dnf/versionlock.toml -maxdepth 0 -printf '%p %T@ %s\n' 2>/dev/null) || true
    # Directories are listed too, so removing a file inside them counts
    config=$(find /etc/dnf/dnf.conf /etc/yum.conf /etc/dnf/vars /etc/yum.repos.d \
        /etc/distro.repos.d /etc/dnf/libdnf5.conf.d /etc/dnf/repos.override.d \
        -maxdepth 1 -printf '%p %T@ %s\n' 2>/dev/null) || true
    boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || true
    sort <<< "${repo_metadata}"$'\n'"${rpmdb}"$'\n'"${versionlock}"$'\n'"${config}"$'\n'"boot_id ${boot_id}"
}

# --- Refresh the cached result (runs detached via --refresh) ---

refresh() {
    init_cache_file "$CACHE_LOCK"
    validate_cache_file "$CACHE_RESULT_TMP"
    validate_cache_file "$CACHE_PENDING"

    # Only one refresh at a time; a concurrent one simply exits.
    if command -v flock >/dev/null 2>&1; then
        exec 9>>"$CACHE_LOCK"
        flock -n 9 || return 0
    fi

    # Removed again only when this refresh completes. Until then the agent
    # backs off and reports since when the result has not been refreshed.
    if [[ -s "$CACHE_PENDING" ]]; then
        touch "$CACHE_PENDING"
    else
        rm -f "$CACHE_PENDING"
        (set -o noclobber; printf '%(%s)T\n' -1 > "$CACHE_PENDING") 2>/dev/null || true
    fi

    # Take the fingerprint first, so changes made while the queries run
    # trigger another refresh.
    local state updates security_info last_timestamp reboot_hint
    state=$(get_pkg_state_fingerprint)
    updates=$(count_updates)
    security_info=$(count_security_updates)
    last_timestamp=$(get_last_update_timestamp)
    reboot_hint=$(get_reboot_hint)

    rm -f "$CACHE_RESULT_TMP"
    if ! (set -o noclobber; printf '%s\n' "$updates" "$security_info" "$last_timestamp" "$reboot_hint" > "$CACHE_RESULT_TMP") \
        || ! mv -f "$CACHE_RESULT_TMP" "$CACHE_RESULT"; then
        return 0
    fi

    # Serve a failure (-1) but clear the fingerprint so the agent retries
    # once the backoff has passed.
    if [[ "$updates" == "-1" || "$security_info" == "-1" ]]; then
        : > "$CACHE_PKG_STATE"
        return 0
    fi
    printf '%s\n' "$state" > "$CACHE_PKG_STATE"
    rm -f "$CACHE_PENDING"
}

# True while the last refresh attempt failed or may still be running and
# started less than RETRY_INTERVAL ago.
refresh_backoff() {
    local last_attempt now
    last_attempt=$(stat -c %Y "$CACHE_PENDING" 2>/dev/null) || return 1
    printf -v now '%(%s)T' -1
    (( now - last_attempt < RETRY_INTERVAL ))
}

# --- Start of the oldest refresh that has not completed (-1 if none) ---

get_refresh_pending_since() {
    local since
    since=$(cat "$CACHE_PENDING" 2>/dev/null) || true
    [[ "$since" =~ ^[0-9]+$ ]] || since=-1
    echo "$since"
}

# Checkmk's socket-activated check-mk-agent@.service kills every process left
# in its cgroup when the agent exits, and setsid doesn't leave the cgroup. So
# on systemd the refresh runs in its own transient unit. systemd-run fails
# without a running systemd, or when the unit already exists (a refresh is
# running); then fall back to setsid, where flock skips a duplicate refresh.
# setsid puts the refresh in its own session, so the agent neither waits for
# it nor kills it when the plugin run ends; timeout bounds the whole refresh.
start_refresh() {
    local self="${BASH_SOURCE[0]}"
    [[ "$self" == /* ]] || self="${PWD}/${self}"

    if command -v systemd-run >/dev/null 2>&1 \
        && systemd-run --no-block --collect --quiet --no-ask-password \
            --unit=cmk-agent-dnf-refresh \
            --property=RuntimeMaxSec="${REFRESH_TIMEOUT}" \
            --setenv=MK_VARDIR="${MK_VARDIR}" \
            "$BASH" "$self" --refresh </dev/null >/dev/null 2>&1; then
        return
    fi

    if command -v setsid >/dev/null 2>&1 && command -v flock >/dev/null 2>&1; then
        setsid timeout "${REFRESH_TIMEOUT}s" "$BASH" "$self" --refresh </dev/null >/dev/null 2>&1 &
    else
        timeout "${INLINE_REFRESH_TIMEOUT}s" "$BASH" "$self" --refresh </dev/null >/dev/null 2>&1 || true
    fi
}

# --- Main ---

main() {
    detect_package_manager

    init_cache_file "$CACHE_RESULT"
    init_cache_file "$CACHE_PKG_STATE"
    validate_cache_file "$CACHE_PENDING"

    if [[ "${1:-}" == "--refresh" ]]; then
        refresh
        return
    fi

    rm -f "${LEGACY_CACHE_FILES[@]}"

    echo "<<<dnf>>>"

    local current_state cached_state
    current_state=$(get_pkg_state_fingerprint)
    cached_state=$(cat "$CACHE_PKG_STATE" 2>/dev/null) || true
    : "${cached_state:=}"

    if [[ "$current_state" != "$cached_state" || ! -s "$CACHE_PKG_STATE" || ! -s "$CACHE_RESULT" ]] \
        && ! refresh_backoff; then
        start_refresh
    fi

    if [[ -s "$CACHE_RESULT" ]]; then
        # Lines 2-4, then the reboot hint (missing in caches of older versions)
        local -a result
        mapfile -t result < "$CACHE_RESULT"
        check_reboot_required
        printf '%s\n' "${result[@]:0:3}"
        get_metadata_timestamp
        get_refresh_pending_since
        echo "${result[3]:-unknown}"
    else
        echo "ERROR: First update check is running in the background, results follow on the next agent run"
    fi
}

main "$@"
