# Set the version to be captured in newer versions of CheckMK inventory
CMK_VERSION="0.0.0"

# Disable globbing to prevent accidental pathname expansion
set -o noglob

# --- Constants ---
# Overall limit for one background refresh, in seconds
readonly REFRESH_TIMEOUT=300
# Limit when setsid/flock are missing and the refresh has to run inline;
# stays below Checkmk's 60 s agent timeout
readonly INLINE_REFRESH_TIMEOUT=45
# Number of recent dnf5 transactions searched for the last upgrade
readonly HISTORY_DEPTH=20

# --- Output error and exit gracefully ---
# Exit 0 so the Checkmk agent continues processing other plugins.
# The server-side check plugin handles the ERROR: prefix.
die() {
    echo "<<<dnf>>>"
    echo "ERROR: $1"
    exit 0
}

# --- Validate environment ---
if [[ -z "${MK_VARDIR:-}" ]]; then
    die "MK_VARDIR not set - agent environment unavailable"
fi

# --- Cache directory and file paths ---
readonly CACHE_DIR="${MK_VARDIR}/cache"

# Ensure cache directory exists and is usable
if ! mkdir -p "${CACHE_DIR}"; then
    die "Unable to create cache directory: ${CACHE_DIR}"
fi

# Result lines 2-4. Named differently from the pre-async 4-line
# yum_result.cache so an upgraded plugin never serves the old format.
readonly CACHE_RESULT="${CACHE_DIR}/dnf_updates.cache"
readonly CACHE_RESULT_TMP="${CACHE_RESULT}.tmp"
readonly CACHE_PKG_STATE="${CACHE_DIR}/dnf_pkg_state.cache"
readonly CACHE_LOCK="${CACHE_DIR}/dnf_refresh.lock"
readonly LEGACY_CACHE_FILES=("${CACHE_DIR}/yum_result.cache" "${CACHE_DIR}/yum_uptime.cache")

# --- Cache file helpers ---

validate_cache_file() {
    local filepath="$1"
    if [[ -L "$filepath" ]]; then
        die "Cache file is a symlink: ${filepath}"
    fi
    if [[ -e "$filepath" && ! -f "$filepath" ]]; then
        die "Cache path is not a regular file: ${filepath}"
    fi
}

init_cache_file() {
    local filepath="$1"
    local default_content="${2:-}"
    if [[ ! -e "$filepath" ]]; then
        echo -n "$default_content" > "$filepath"
    fi
    validate_cache_file "$filepath"
}

# --- Detect distribution ---

detect_distribution() {
    # Variables from /etc/os-release (SC2154)
    # shellcheck disable=SC2154
    if [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        MAJOR_VERSION="${VERSION_ID%%.*}"

        # Normalise to RHEL family using ID_LIKE
        if [[ "${ID_LIKE:-}" == *rhel* ]] || [[ "${ID}" == "rhel" ]]; then
            DISTRO_ID="rhel"
        else
            DISTRO_ID="${ID}"
        fi
    else
        MAJOR_VERSION=0
        DISTRO_ID="unknown"
    fi
}

# --- Detect package manager ---

detect_package_manager() {
    if command -v dnf5 >/dev/null 2>&1; then
        PKG_MGR="dnf5"
    elif command -v dnf >/dev/null 2>&1; then
        PKG_MGR="dnf"
    elif command -v yum >/dev/null 2>&1; then
        PKG_MGR="yum"
    else
        die "No supported package manager found (dnf5, dnf, or yum)"
    fi
}

# --- Check if kernel update requires reboot ---

check_reboot_required() {
    local kernel_package running_kernel latest_kernel

    kernel_package=$(rpm -qf --qf "%{NAME}" "/boot/config-$(uname -r)" 2>/dev/null) || true
    if [[ -z "$kernel_package" ]]; then
        echo "no"
        return
    fi

    running_kernel=$(rpm -qf --qf "%{VERSION}-%{RELEASE}\n" "/boot/config-$(uname -r)" 2>/dev/null) || true
    latest_kernel=$(rpm -q --qf "%{INSTALLTIME} %{VERSION}-%{RELEASE}\n" "$kernel_package" 2>/dev/null \
        | sort -nr | head -n1 | cut -d' ' -f2-) || true

    if [[ "$running_kernel" == "$latest_kernel" ]]; then
        echo "no"
    else
        echo "yes"
    fi
}

# --- List pending upgrades ---
# Prints one "name.arch" per pending upgrade. Returns 2 if the package manager
# rejected an option (e.g. --security unsupported) and 1 on any other failure
# (timeout, missing metadata cache, lock, repo error). check-update exits 100
# when upgrades exist and 0 when there are none.

list_upgrades() {
    local -a cmd
    local output rc=0

    case "$PKG_MGR" in
        dnf5)    cmd=(dnf5 -C --quiet check-upgrade) ;;
        dnf|yum) cmd=("$PKG_MGR" -C --quiet --noplugins check-update) ;;
    esac

    output=$("${cmd[@]}" "$@" 2>/dev/null) || rc=$?
    case "$rc" in
        0|100) ;;
        2) return 2 ;;
        *) return 1 ;;
    esac

    # Package lines start in column 1; wrapped continuation lines are indented.
    # The trailing "Obsoleting Packages" section repeats entries, so stop there.
    printf '%s\n' "$output" | awk '/^Obsoleting/ {exit} /^[^[:space:]]/ {print $1}'
}

# --- Count available package updates (-1 on error) ---

count_updates() {
    local upgrades
    if ! upgrades=$(list_upgrades); then
        echo "-1"
        return
    fi
    grep -c . <<< "$upgrades" || true
}

# --- Count security updates and list affected packages ---
# -1 on error, -2 if the package manager does not support --security.

count_security_updates() {
    local upgrades count pkg_list rc=0

    upgrades=$(list_upgrades --security) || rc=$?
    case "$rc" in
        0) ;;
        2) echo "-2"; return ;;
        *) echo "-1"; return ;;
    esac

    count=$(grep -c . <<< "$upgrades") || true
    pkg_list=$(grep . <<< "$upgrades" | sed 's/\.[^.]*$//' | paste -sd, -) || true
    printf '%s %s\n' "${count:-0}" "${pkg_list:-}"
}

# --- Timestamp of the most recent dnf5 upgrade transaction ---
# dnf5's history table leaves the Action column empty and its command-line
# column has a variable number of words, so read "history info" instead.

get_last_upgrade_dnf5() {
    local -a ids
    local history id_list begin

    history=$(dnf5 history list 2>/dev/null) || true
    id_list=$(awk -v max="$HISTORY_DEPTH" '$1 ~ /^[0-9]+$/ && n++ < max {print $1}' <<< "$history") || true
    read -r -d '' -a ids <<< "$id_list" || true
    (( ${#ids[@]} )) || return 0

    # "Begin time" is YYYY-MM-DD HH:MM:SS, so the string maximum is the latest.
    begin=$(dnf5 history info "${ids[@]}" 2>/dev/null \
        | awk '/^Begin time/ {sub(/^Begin time *: */, ""); begin = $0}
               /^[[:space:]]+Upgrade[[:space:]]/ && begin > last {last = begin}
               END {print last}')
    [[ -n "$begin" ]] && date -d "$begin" +"%s" 2>/dev/null
}

# --- Determine timestamp of last successful update ---

get_last_update_timestamp() {
    local timestamp=""

    case "$PKG_MGR" in
        dnf5)
            timestamp=$(get_last_upgrade_dnf5) || true
            ;;
        dnf|yum)
            timestamp=$("$PKG_MGR" -C --quiet --noplugins history list 2>/dev/null \
                | awk '{if(NR>2)print}' \
                | grep -E ' U | Upgrade| Update' \
                | head -n1 \
                | awk -F'|' '{print $3}' \
                | date -f - +"%s" 2>/dev/null) || true
            ;;
    esac

    echo "${timestamp:--1}"
}

# --- Package state fingerprint ---
# Changes when repo metadata is refreshed (repomd.xml per repo; dnf5 keeps its
# cache in /var/cache/libdnf5) or packages are installed or removed (rpmdb,
# including plain rpm -U). Solver caches (*.solv) are left out because dnf
# rewrites them during read-only queries.

get_pkg_state_fingerprint() {
    local repo_metadata rpmdb
    repo_metadata=$(find /var/cache/dnf /var/cache/yum /var/cache/libdnf5 \
        -name repomd.xml -printf '%p %T@ %s\n' 2>/dev/null) || true
    rpmdb=$(find /var/lib/rpm /usr/lib/sysimage/rpm -maxdepth 1 \
        \( -name Packages -o -name rpmdb.sqlite -o -name rpmdb.sqlite-wal \) \
        -printf '%p %T@ %s\n' 2>/dev/null) || true
    sort <<< "${repo_metadata}"$'\n'"${rpmdb}"
}

# --- Refresh the cached result (runs detached via --refresh) ---

refresh() {
    validate_cache_file "$CACHE_LOCK"
    validate_cache_file "$CACHE_RESULT_TMP"

    # Only one refresh at a time; a concurrent one simply exits.
    if command -v flock >/dev/null 2>&1; then
        exec 9>>"$CACHE_LOCK"
        flock -n 9 || return 0
    fi

    # Take the fingerprint first, so changes made while the queries run
    # trigger another refresh.
    local state updates security_info last_timestamp
    state=$(get_pkg_state_fingerprint)
    updates=$(count_updates)
    security_info=$(count_security_updates)
    last_timestamp=$(get_last_update_timestamp)

    printf '%s\n' "$updates" "$security_info" "$last_timestamp" > "$CACHE_RESULT_TMP"
    mv -f "$CACHE_RESULT_TMP" "$CACHE_RESULT"

    # Serve a failure (-1) but clear the fingerprint so the next agent run
    # retries.
    if [[ "$updates" == "-1" || "$security_info" == "-1" ]]; then
        : > "$CACHE_PKG_STATE"
        return 0
    fi
    printf '%s\n' "$state" > "$CACHE_PKG_STATE"
}

# setsid puts the refresh in its own session, so the agent neither waits for
# it nor kills it when the plugin run ends; timeout bounds the whole refresh.
start_refresh() {
    local self="${BASH_SOURCE[0]}"
    if command -v setsid >/dev/null 2>&1 && command -v flock >/dev/null 2>&1; then
        setsid timeout "${REFRESH_TIMEOUT}s" bash "$self" --refresh </dev/null >/dev/null 2>&1 &
    else
        timeout "${INLINE_REFRESH_TIMEOUT}s" bash "$self" --refresh </dev/null >/dev/null 2>&1 || true
    fi
}

# --- Main ---

main() {
    detect_distribution
    detect_package_manager

    init_cache_file "$CACHE_RESULT"
    init_cache_file "$CACHE_PKG_STATE"

    if [[ "${1:-}" == "--refresh" ]]; then
        refresh
        return
    fi

    rm -f "${LEGACY_CACHE_FILES[@]}"

    echo "<<<dnf>>>"

    local current_state cached_state
    current_state=$(get_pkg_state_fingerprint)
    cached_state=$(cat "$CACHE_PKG_STATE" 2>/dev/null) || true
    : "${cached_state:=}"

    if [[ "$current_state" != "$cached_state" || ! -s "$CACHE_PKG_STATE" || ! -s "$CACHE_RESULT" ]]; then
        start_refresh
    fi

    if [[ -s "$CACHE_RESULT" ]]; then
        check_reboot_required
        cat "$CACHE_RESULT"
    else
        echo "ERROR: First update check is running in the background, results follow on the next agent run"
    fi
}

main "$@"
